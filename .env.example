# LLM Provider API Keys
# Copy this file to .env and fill in the keys you need.
# Only the provider you're using needs a key.

# Anthropic API (for anthropic_api provider)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI-compatible API (for openai_api provider)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1  # default; change for Groq, Together, etc.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1  # Groq
# OPENAI_BASE_URL=https://api.together.xyz/v1     # Together AI

# Ollama (for ollama provider — no key needed, just the URL)
# OLLAMA_BASE_URL=http://localhost:11434  # default
